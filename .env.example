# JWT — debe coincidir con el secret del servicio Auth
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256

# URL del App_backend
# Local:   http://localhost:8000
# Railway: https://<app-backend-service>.up.railway.app
APP_BACKEND_URL=http://localhost:8000

# Token interno para el endpoint de entrenamiento (compartido con App_backend)
INTERNAL_SERVICE_TOKEN=change-this-internal-token

# Umbrales para transición entre etapas
MIN_RECORDS_FOR_WMA=10
MIN_DAYS_FOR_WMA=28
MIN_DAYS_FOR_GBM=56

# Prior bayesiano (unidades/día asumidas sin datos)
BAYESIAN_PRIOR_ALPHA=1.0
BAYESIAN_PRIOR_BETA=6.0
