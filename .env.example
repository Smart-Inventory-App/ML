MIN_DAYS_FOR_WMA=28
MIN_DAYS_FOR_GBM=56

# Prior bayesiano (unidades/semana asumidas sin datos)
BAYESIAN_PRIOR_ALPHA=1.0
BAYESIAN_PRIOR_BETA=6.0
